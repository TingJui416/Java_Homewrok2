        gas = g;
        System.out.println("將車號設為" + num + ",汽油量設為" + gas);
    }
    
    public void setName(String nm) {
        name = nm;
        System.out.println("將車名設為" + name);
    }
    
    public void show() {
        System.out.println("車號是" + num);
        System.out.println("汽油量是" + gas);
        System.out.println("車名是" + name);
    }
}
